<!-- Modal -->
<div class="modal fade" id="donutModal" tabindex="-1" role="dialog" aria-labelledby="donutModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" role="document" style="max-width: 1000px">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="donutModalLabel">Detail Readiness</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<table class="table table-striped table-bordered text-center align-middle">
					<thead class="table-dark">
						<tr>
							<th style="width: 50px">Detail</th>
							<th>Kategori</th>
							<th>Readiness Stock</th>
						</tr>
					</thead>
					<tbody></tbody>
				</table>
			</div>
			<div class="modal-footer">
				<ul class="list-unstyled">
					<li>Index :</li>
					<li><span class="mdi mdi-circle text-success"></span> &ge; 115%</li>
					<li><span class="mdi mdi-circle text-warning"></span> 100% &le; x &lt; 115%</li>
					<li><span class="mdi mdi-circle text-danger"></span> &lt; 100%</li>
				</ul>
			</div>
		</div>
	</div>
</div>
