@using Lexa.Helpers
@{
	ViewBag.Title = "Dashboard";
	ViewBag.subTitle = "Home";
	ViewBag.subTitleLink = "/";
	Layout = "~/Views/Shared/_Layout.cshtml";

    var hasPermissionBarangRead = User.HasPermissionOrSuper("barang:read");
    var hasPermissionApprovalRead = User.HasPermissionOrSuper("approval:read");
    var hasPermissionRiwayatStockRead = User.HasPermissionOrSuper("riwayat:stock:read");
    var hasPermissionRiwayatTransaksiRead = User.HasPermissionOrSuper("riwayat:transaksi:read");
}

@section AddToHead {
	<link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    @* <style>
        #wrapper-dashboard {
            position: relative;   /* important */
        }

        .spinner-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,0.7);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 999;
        }
    </style> *@
}

@section scripts {
	<script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
	<script src="~/assets/libs/morris.js/morris.min.js"></script>
	<script src="~/assets/libs/raphael/raphael.min.js"></script>
	<script src="~/assets/js/pages/dashboard.init.js"></script>
	<script src="~/assets/js/app.js"></script>
    @* <script>
        window.permission = {
            hasPermissionBarangRead: @(hasPermissionBarangRead.ToString().ToLower()),
        }
    </script> *@
}

<div id="error-dashboard" hidden>
    <div class="alert alert-danger" role="alert">
        Gagal memuat data dashboard!
    </div>
</div>
<div id="wrapper-dashboard" hidden>
<!--menu-->
<div class="row card-deck">
	<!--menu-->
	<div class="col-xl-3 col-sm-6 d-flex">
		<div class="card mini-stat flex-fill gradient blue-gradient">
			<div class="card-body mini-stat-img">
				<div class="mini-stat-icon">
					<i class="mdi mdi-folder-download-outline float-end"></i>
				</div>
				<div class="text-white">
					<h6 class="text-uppercase mb-3 font-size-16 text-white">Total Pemasukkan Barang</h6>
					<h2 id="transact_in_cnt" class="text-white"></h2>
				</div>
			</div>
            @if(hasPermissionRiwayatStockRead) {
                <div class="card-footer text-center card-footer-bg-color">
                    <a href="/RiwayatTransaksi/RiwayatStock" class="text-white">Lebih Lanjut <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            }
		</div>
	</div>
	<!--menu-->
	<div class="col-xl-3 col-sm-6 d-flex">
		<div class="card mini-stat flex-fill gradient green-gradient">
			<div class="card-body mini-stat-img">
				<div class="mini-stat-icon">
					<i class="mdi mdi-folder-upload-outline float-end"></i>
				</div>
				<div class="text-white">
					<h6 class="text-uppercase mb-3 font-size-16 text-white">Jumlah Permintaan Barang</h6>
					<h2 id="transact_out_cnt" class="text-white"></h2>
				</div>
			</div>
            @if(hasPermissionRiwayatTransaksiRead) {
                <div class="card-footer text-center card-footer-bg-color">
                    <a href="/riwayattransaksi" class="text-white">Lebih Lanjut <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            }
		</div>
	</div>
	<!--menu-->
	<div class="col-xl-3 col-sm-6 d-flex">
		<div class="card mini-stat flex-fill gradient orange-gradient">
			<div class="card-body mini-stat-img">
				<div class="mini-stat-icon">
					<i class="mdi mdi-clock-outline float-end"></i>
				</div>
				<div class="text-white">
					<h6 class="text-uppercase mb-3 font-size-16 text-white">Jumlah Permintaan Menunggu</h6>
					<h2 id="transact_pending_cnt" class="text-white"></h2>
				</div>
			</div>
            @if(hasPermissionApprovalRead) {
                <div class="card-footer text-center card-footer-bg-color">
                    <a href="/approval" class="text-white">Lebih Lanjut <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            }
		</div>
	</div>
	<!--menu-->
	<div class="col-xl-3 col-sm-6 d-flex">
		<div class="card mini-stat flex-fill gradient red-gradient">
			<div class="card-body mini-stat-img">
				<div class="mini-stat-icon">
					<i class="mdi mdi-alert-outline float-end"></i>
				</div>
				<div class="text-white">
					<h6 class="text-uppercase mb-3 font-size-16 text-white">Peringatan Stock Barang Rendah</h6>
					<h2 id="item_low_stock_cnt" class="text-white"></h2>
				</div>
			</div>
            @if(hasPermissionBarangRead) {
                <div class="card-footer text-center card-footer-bg-color">
                    <a href="/stockgudang" class="text-white">Lebih Lanjut <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            }
		</div>
	</div>
</div>


