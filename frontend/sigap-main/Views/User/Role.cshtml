                </table>
                <!-- Modal: Tambah Barang -->
                <div class="modal fade" id="modalTambahRoleJabatan" tabindex="-1" aria-labelledby="modalTambahRoleJabatanLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modalTambahRoleJabatan">Tambah Role</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>

                            <form id="formTambahRole">
                                <div class="modal-body">
                                    <div class="row g-3">

                                        @* <div class="col-md-6"> *@
                                        <div class="col-md-12">
                                            <label class="form-label">Kode Role<span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="roleCode" name="code" placeholder="masukkan kode role" required>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">Nama Role<span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="roleName" name="name" placeholder="masukkan nama role" required>
                                        </div>
                                        @* <div class="col-md-6"> *@
                                        <div class="col-md-12">
                                            <label class="form-label">Deskripsi</label>
                                            <textarea id="roleDescription" name="description" class="form-control" maxlength="225" rows="3" placeholder="masukkan deskripsi role"></textarea>
                                        </div>

                                        <input id="roleHidden" type="hidden" name="is_active" value="true">

                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                    <button type="submit" class="btn btn-info">Simpan</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <!-- Modal Edit Role-->
                <div class="modal fade" id="modalEditRoleJabatan" tabindex="-1" aria-labelledby="modalEditRoleJabatanLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="modalEditBarangLabel">Edit Role</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form id="formEditRole">
                                <div class="modal-body">
                                    <div class="row g-3">

                                        @* <div class="col-md-6"> *@
                                        <div class="col-md-12">
                                            <label class="form-label">kode role<span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="roleCodeEdit" name="code_edit" placeholder="masukkan kode role" required>
                                        </div>
                                        <div class="col-md-12">
                                            <label class="form-label">nama role<span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" id="roleNameEdit" name="name_edit" placeholder="masukkan nama role" required>
                                        </div>
                                        @* <div class="col-md-6"> *@
                                        <div class="col-md-12">
                                            <label class="form-label">Deskripsi</label>
                                            <textarea id="roleDescriptionEdit" name="deksripsi_edit" class="form-control" maxlength="225" rows="3" placeholder="masukkan deskripsi role"></textarea>
                                        </div>

                                        <input id="roleHiddenEdit" type="hidden" name="is_active" value="true">
                                        <input id="roleEditId" type="hidden" />

                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                                    <button type="submit" class="btn btn-info">Simpan</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
