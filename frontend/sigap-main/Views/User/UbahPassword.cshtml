@{
	ViewBag.Title = "Ubah Password";
	ViewBag.TitleLink = "/users/ubahpassword";
	ViewBag.subTitle = "Ubah Password";
	ViewBag.subTitleLink = "/users";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@section AddToHead {
	<link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
	<link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

@section scripts {
	<script src="~/assets/js/app.js"></script>
	<script src="~/assets/libs/select2/js/select2.min.js"></script>
	<script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
	<script src="~/assets/js/pages/tambah-barang.js"></script>
}
<div class="row">
	<div class="col-12">
		<div class="card">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h1>Edit password</h1>
				</div>

				<div class="row">

					<div class="col-md-6">
						<div class="form-group mb-3">
							<label for="NamaBarang">Nama Pekerja<span class="text-red">*</span></label>
							<input type="text" name="Nama Barang" class="form-control" id="namabarang" value="" placeholder="Masukkan Nama Barang" required >
						</div>
						<div class="form-group mb-3">
							<label for="Jumlah">Nomor Pekerja<span class="text-red">*</span></label>
							<input type="text" name="Jumlah" class="form-control" id="jumlahbarang" maxlength="18" size="18" value="" placeholder="Masukkan Jumlah Barang" required>
						</div>
					</div>
					<div class="col-md-6">
						<div class="form-group mb-3">
							<label for="example-password-input" class="col-md-2 col-form-label">Password<span class="text-red">*</span></label>
							<input class="form-control" type="password" value="hunter2" id="example-password-input">
						</div>
						<div class="form-group mb-3">
							<label for="example-password-input" class="col-md col-form-label">Konfirmasi Password<span class="text-red">*</span></label>
							<input class="form-control" type="password" value="hunter2" id="example-password-input">
						</div>
					</div>
					<div class="card-footer" style="background-color: white;">
						<button id="submit-tambah-button" type="submit" class="btn btn-info float-end">Tambah</button>
					</div>
				</div>
			</div>
		</div>
	</div>
