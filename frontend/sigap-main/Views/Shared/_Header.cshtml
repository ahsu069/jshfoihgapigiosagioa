<!-- Modal: Ubah Password -->
<div class="modal fade" id="ubahPasswordModal" tabindex="-1" aria-labelledby="ubahPasswordLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
        
        <div class="modal-header">
            <h5 class="modal-title" id="ubahPasswordLabel">Ubah Password</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        
        <form id="formUbahPassword">
        <div class="modal-body">
                <div class="mb-3">
                    <div class="input-group has-validation">
                        <span class="input-group-text" id="inputGroupPrependOldPassword"><i class="mdi mdi-lock"></i></span>
                        <div class="flex-grow-1 position-relative">
                            <input name="oldPassword" type="password" class="form-control" id="oldPassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" aria-describedby="inputGroupPrependOldPassword oldPasswordFeedback" placeholder="Masukkan password lama" required>
                            <button type="button"
                                    class="btn btn-sm position-absolute top-50 end-0 translate-middle-y toggle-password"
                                    aria-label="Toggle password visibility"
                                    style="background: transparent; border: none; padding: 0.25rem 0.5rem;"
                                    data-target="oldPassword">
                                <i class="mdi mdi-eye-off" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div id="oldPasswordFeedback" class="invalid-feedback d-none">
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="input-group has-validation">
                        <span class="input-group-text" id="inputGroupPrependNewPassword"><i class="mdi mdi-lock"></i></span>
                        <div class="flex-grow-1 position-relative">
                            <input name="newPassword" type="password" class="form-control" id="newPassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" aria-describedby="inputGroupPrependNewPassword newPasswordFeedback" placeholder="Masukkan password baru" required>
                            <button type="button"
                                    class="btn btn-sm position-absolute top-50 end-0 translate-middle-y toggle-password"
                                    aria-label="Toggle password visibility"
                                    style="background: transparent; border: none; padding: 0.25rem 0.5rem;"
                                    data-target="newPassword">
                                <i class="mdi mdi-eye-off" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div id="newPasswordFeedback" class="invalid-feedback d-none">
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="input-group has-validation">
                        <span class="input-group-text" id="inputGroupPrependConfirmPassword"><i class="mdi mdi-lock"></i></span>
                        <div class="flex-grow-1 position-relative">
                            <input name="confirmPassword" type="password" class="form-control" id="confirmPassword" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" aria-describedby="inputGroupPrependConfirmPassword confirmPasswordFeedback" placeholder="Ulangi password baru" required>
                            <button type="button"
                                    class="btn btn-sm position-absolute top-50 end-0 translate-middle-y toggle-password"
                                    aria-label="Toggle password visibility"
                                    style="background: transparent; border: none; padding: 0.25rem 0.5rem;"
                                    data-target="confirmPassword">
                                <i class="mdi mdi-eye-off" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div id="confirmPasswordFeedback" class="invalid-feedback d-none">
                        </div>
                    </div>
                </div>
                <input type="hidden" id="userId" value="@userId" />
                <input type="hidden" id="userNama" value="@userNama" />
        </div>
        
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
            <button type="submit" class="btn btn-info" id="btnSavePassword">Simpan</button>
        </div>
        </form>
        
        </div>
    </div>
</div>
