                                                        <p id="statustransaksi" class="mb-1"></p>
                                                    </div>
                                                    <div id="keterangan" class="alert alert-warning p-2 px-3" role="alert"></div>
                                                    @* <div class="row">
                                                        <p id="keterangan"></p>
                                                    </div> *@
                                                </div>
                                            </div>
                                            <div class="row mt-2">
                                                <div class="col-3">
