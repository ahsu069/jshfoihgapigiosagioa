                                                        style="min-height:60px; white-space:pre-wrap;">-</div>
                                                </div>
                                            </div>
                                            <div id="filependukung-row" class="row">
                                                <div class="col-3">
                                                    <p>File Pendukung</p>
                                                </div>
                                                <div class="col-8">
                                                    <p id="filependukung"></p>
                                                </div>
                                            </div>
                                            @* <p id="id-finger"></p>
                                            <p id="fungsi"></p>
                                            <p id="statustransaksi"></p>
                                            <p id="filependukung"></p> *@
                                        </div>
                                    </div>
                                    @* <div class="row">
                                        <div class="col-xl-6 col-sm-12">
                                            <p id="no-miv-safety"> Nomor MIV : 001/39/HSSE/KPI4XXXX/2025</p>
