                                        </div>
                                    </div> *@
                                    <hr style="border: 10px solid #2B3A4A; opacity: 1" />
                                    <div class="row mt-4">
                                        <div class="table-responsive mb-0 detail-approval" data-pattern="priority-columns">
                                            @* <table class="table table-bordered border border-1 border-black"> *@
                                            <table class="table table-bordered">
                                                <thead class="table-dark text-center align-middle">
                                                    <tr>
                                                        <th>No</th>
                                                        <th>Nama Barang</th>
                                                        <th>Jumlah</th>
