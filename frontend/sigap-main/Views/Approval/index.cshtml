                                                        @* <th>Keterangan</th> *@
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @* <tr>
                                                        <td>1.</td>
                                                        <td>Helm Pertamina (merah)</td>
                                                        <td>1</td>
                                                        <td>Pcs</td>
                                                        <td>-</td>
                                                    </tr>
                                                    <tr>
                                                        <td>2.</td>
                                                        <td>Suspensi Helm</td>
                                                        <td>1</td>
                                                        <td>Pcs</td>
                                                        <td>-</td>
                                                    </tr>
                                                    <tr>
                                                        <td>3.</td>
                                                        <td>Tali Dagu</td>
                                                        <td>1</td>
                                                        <td>Pcs</td>
                                                        <td>-</td>
                                                    </tr>
                                                    <tr>
                                                        <td>4.</td>
                                                        <td>Safety Blackrhino (size 14)</td>
                                                        <td>1</td>
                                                        <td>Pcs</td>
                                                        <td>Sepatu Rusak Setelah dipakai 4 bulan</td>
                                                    </tr> *@
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>