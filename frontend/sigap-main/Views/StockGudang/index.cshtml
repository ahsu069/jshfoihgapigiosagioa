@using Lexa.Helpers
@{
    ViewBag.title = "Master Data";
    ViewBag.subTitle = "Stock Gudang";
    ViewBag.subTitleLink = "/stockgudang";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var hasItemCreate = User.HasPermissionOrSuper("barang:create");
    var hasItemEdit = User.HasPermissionOrSuper("barang:update");
    var hasItemRead = User.HasPermissionOrSuper("barang:read");
    var hasItemDelete = User.HasPermissionOrSuper("barang:delete");
    var hasItemKategori = User.HasPermissionOrSuper("kategori_barang:read");

}
@section AddToHead {
    <!-- DataTables -->
    <link href="~/assets/libs/datatables.net-bs5/css/dataTables.bootstrap5.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/datatables.net-buttons-bs5/css/buttons.bootstrap5.min.css" rel="stylesheet" type="text/css" />

    <!-- Responsive datatable -->
    <link href="~/assets/libs/datatables.net-responsive-bs5/css/responsive.bootstrap5.min.css" rel="stylesheet" type="text/css" />

    <!-- Plugins datatable -->
    <link href="~/assets/libs/datatables.net-select-bs5/css/select.bootstrap5.min.css" rel="stylesheet" type="text/css" />
	<link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
}
@section scripts {
    <!-- Init js -->
    <script src="~/assets/js/app.js"></script>
    <!-- Required datatable js -->
    <script src="~/assets/libs/datatables.net/js/dataTables.min.js"></script>
    <script src="~/assets/libs/datatables.net-bs5/js/dataTables.bootstrap5.min.js"></script>
    <!-- Buttons examples -->
    <script src="~/assets/libs/datatables.net-buttons/js/dataTables.buttons.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons-bs5/js/buttons.bootstrap5.min.js"></script>
    <script src="~/assets/libs/jszip/jszip.min.js"></script>
    <script src="~/assets/libs/pdfmake/build/pdfmake.min.js"></script>
    <script src="~/assets/libs/pdfmake/build/vfs_fonts.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/buttons.html5.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/buttons.print.min.js"></script>
    <script src="~/assets/libs/datatables.net-buttons/js/buttons.colVis.min.js"></script>
    <!-- Responsive examples -->
    <script src="~/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/assets/libs/datatables.net-responsive-bs5/js/responsive.bootstrap5.min.js"></script>
    <script src="~/assets/libs/datatables.net-select/js/dataTables.select.min.js"></script>
    <script src="~/assets/libs/datatables.net-select-bs5/js/select.bootstrap5.min.js"></script>
	<script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/assets/libs/select2/js/select2.min.js"></script>
    <!-- Stock Gudang js-->
    <script src="~/assets/js/pages/stock-gudang.js"></script>
    <script>
        window.User = {
            hasItemCreate: @(hasItemCreate.ToString().ToLower()),
            hasItemRead: @(hasItemRead.ToString().ToLower()),
            hasItemEdit: @(hasItemEdit.ToString().ToLower()),
            hasItemDelete: @(hasItemDelete.ToString().ToLower()),
            hasItemKategori: @(hasItemKategori.ToString().ToLower()),
        };
    </script>
}

<div class="row">
    <div class="col-12">
        <!--halaman stock gudang-->
        <div class="card">
            <div class="card-body">
                <h1>Master Stock Gudang</h1>
