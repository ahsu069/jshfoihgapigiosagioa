                <!-- Modal: Tambah Barang -->
                <div class="modal fade" id="modalTambahBarang" tabindex="-1" aria-labelledby="modalTambahBarangLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalTambahBarangLabel">Tambah Barang</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <form id="formTambahBarang" enctype="multipart/form-data">
                            <div class="modal-body">
                            <div class="row g-3">
                                
                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Nama Barang<span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="nama_barang" placeholder="masukkan nama barang" required>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Satuan<span class="text-danger">*</span></label>
                                <select class="form-control" name="satuanbar_id" required>
                                    @* <option value="">pilih satuan</option> *@
                                </select>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Kategori<span class="text-danger">*</span></label>
                                <select class="form-control " name="kategoribar_id" required>
                                    @* <option value="">pilih kategori</option> *@
                                </select>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Jumlah<span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="jumlah_barang" min="0" placeholder="masukkan jumlah barang" required>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">MSL<span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="msl_barang" min="0" placeholder="masukkan msl barang" required>
                                </div>

                                @* <div class="col-md-6">
                                <div class="col-md-12">
                                <label class="form-label">Status</label>
                                <input type="text" class="form-control" name="status_bar" placeholder="masukkan status barang">
                                </div> *@

                                <div class="col-12">
                                @* <label class="form-label">Gambar<span class="text-danger">*</span></label> *@
                                <label class="form-label">Gambar</label>
                                @* <input type="file" class="form-control" name="link_gambar_bar" accept="image/*" required> *@
                                <input type="file" class="form-control" name="link_gambar_bar" accept="image/*">
                                <img id="preview_gambar" class="mt-2 rounded shadow-sm d-none" width="120" alt="Preview">
                                </div>

                                <input type="hidden" name="is_deleted" value="false">
                                <input type="hidden" id="idEdit" name="idEdit">

                            </div>
                            </div>

                            <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                            <button type="submit" class="btn btn-info">Simpan</button>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>

                <!-- Modal: Edit Barang -->
                <div class="modal fade" id="modalEditBarang" tabindex="-1" aria-labelledby="modalEditBarangLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalEditBarangLabel">Edit Barang</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <form id="formEditBarang" enctype="multipart/form-data">
                            <div class="modal-body">
                            <div class="row g-3">
                                
                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Nama Barang<span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="nama_barang_edit" placeholder="masukkan nama barang" required>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Satuan<span class="text-danger">*</span></label>
                                <select class="form-control" name="satuanbar_id_edit" required>
                                    @* <option value="">pilih satuan</option> *@
                                </select>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Kategori<span class="text-danger">*</span></label>
                                <select class="form-control" name="kategoribar_id_edit" required>
                                    @* <option value="">pilih kategori</option> *@
                                </select>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">Jumlah<span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="jumlah_barang_edit" min="0" placeholder="masukkan jumlah barang" required>
                                </div>

                                @* <div class="col-md-6"> *@
                                <div class="col-md-12">
                                <label class="form-label">MSL<span class="text-danger">*</span></label>
                                <input type="number" class="form-control" name="msl_barang_edit" min="0" placeholder="masukkan msl barang" required>
                                </div>

                                @* <div class="col-md-6">
                                <div class="col-md-12">
                                <label class="form-label">Status</label>
                                <input type="text" class="form-control" name="status_bar_edit" placeholder="masukkan status barang">
                                </div>*@

                                <div class="col-12">
                                @* <label class="form-label">Gambar<span class="text-danger">*</span></label> *@
                                <label class="form-label">Gambar</label>
                                @* <input type="file" class="form-control" name="link_gambar_bar" accept="image/*" required> *@
                                <input type="file" class="form-control" name="link_gambar_bar_edit" accept="image/*">
                                <img id="preview_gambar_edit" class="mt-2 rounded shadow-sm d-none" width="120" alt="Preview">
                                </div>

                                <input type="hidden" name="is_deleted" value="false">

                            </div>
                            </div>

                            <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                            <button type="submit" class="btn btn-info">Simpan</button>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>

                <div class="modal fade" id="itemDetailModal" tabindex="-1" aria-labelledby="itemDetailModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content" style="border-radius: 16px; overflow: hidden;">
                            <div class="modal-body p-0">
                                <div class="card w-100 m-0" style="border: 1px solid black; border-radius: 16px;">
                                    <div class="card-header d-flex justify-content-center position-relative"
                                        style="background-color: #ffffff; border-radius: 16px;">
                                        <img class="card-img-top-custom" src="/assets/images/dummy.png"
                                            alt="Gambar Barang" style="max-height: 250px; object-fit: contain;" />
                                        <button type="button" class="btn-close position-absolute top-0 end-0 m-2" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                    </div>
                                    <div class="card-body text-white text-center p-0"
                                        style="background-color: #2b3a4a; border-radius: 0px 0px 16px 16px; border: 1px solid white;">
                                        
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0"><strong class="nama-barang">-</strong></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0">Kategori: <span class="kategori-barang">-</span></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0">Satuan: <span class="satuan-barang">-</span></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0">Stok: <span class="badge bg-info stok-barang">-</span></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0">Booked: <span class="badge bg-info booked-barang">-</span></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0">Jumlah: <span class="badge bg-info jumlah-barang">-</span></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0">Minimum Stock Level: <span class="badge bg-info msl-barang">-</span></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <h5 class="mb-0">Status: <span class="badge bg-success status-barang">-</span></h5>
                                        </div>
                                        <div class="p-2 d-flex align-items-center justify-content-center border-top border-white" style="height: 48px;">
                                            <button type="button" class="btn btn-info" data-bs-dismiss="modal" aria-label="Close">Tutup</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


