@{
}
@{
	ViewBag.Title = "Divisi Kategori";
	ViewBag.TitleLink = "/stockgudang/tambahkategori";
	ViewBag.subTitle = "divisi kategori";
	ViewBag.subTitleLink = "/stockgudang";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

@section AddToHead {
	<link href="~/assets/libs/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
	<link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
}

@section scripts {
	<script src="~/assets/js/app.js"></script>
	<script src="~/assets/libs/select2/js/select2.min.js"></script>
	<script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
	<script src="~/assets/js/pages/tambahkategori.js"></script>
}
<div class="row">
	<div class="col-12">
		<div class="card">
			<div class="card-body">
				<div class="d-flex justify-content-between align-items-center mb-3">
					<h1>Divisi kategori</h1>
					<div class=" col-6 col-md-2 justify-content-end text-end">
						<a class="btn btn-info waves-effect waves-light" href="/StockGudang/TambahKategori" role="button">
							<i class="mdi mdi-arrow-left"></i>
							<span>Kembali</span>
						</a>
					</div>
				</div>

				<div class="row">

					<div class="col-md-6">
						<div class="form-group mb-3">
							<label for="NamaBarang">defisi kategori<span class="text-red">*</span></label>
							<input type="text" name="Nama Barang" class="form-control" id="namabarang" value="" placeholder="Masukkan Nama Barang" required>
						</div>
					<div class="card-footer" style="background-color: white;">
						<button id="submit-tambah-button" type="submit" class="btn btn-info float-end">Tambah</button>
					</div>
				</div>

			</div>
		</div>
	</div>
</div>
