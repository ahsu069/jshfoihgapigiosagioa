                            <div class="col-4">
                                <h5 class="font-size-20">$ 8974</h5>
                                <p class="text-muted">Last Month</p>
                            </div>
                        </div>

                        <div id="morris-area-example" data-colors='["#f0f1f4","--bs-primary","--bs-info"]'
                             class="morris-charts morris-charts-height" dir="ltr"></div>
                    </div>
                </div>
