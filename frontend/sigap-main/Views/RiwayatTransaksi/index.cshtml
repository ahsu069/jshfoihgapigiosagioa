@using Lexa.Helpers
@{
    ViewBag.Title = "Dashboard Riwayat Transaksi";
    ViewBag.TitleLink = "/riwayattransaksi";
    ViewBag.subTitle = "Riwayat Transaksi";
    ViewBag.subTitleLink = "/riwayattransaksi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var userId = @User.FindFirst("UserId")?.Value;
    var hasRiwayatStock = User.HasPermissionOrSuper("transaksi:riwayat_stock:read");
}

